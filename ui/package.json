{
  "name": "traderbro-ui",
  "version": "0.3.0",
  "private": true,
  "description": "TraderBro monitoring UI — Angular 20 + Taiga UI 4 + lightweight-charts 5 (read-only).",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
