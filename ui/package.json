    "@angular/platform-browser-dynamic": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@maskito/angular": "^5.6.0",
    "@maskito/core": "^5.6.0",
    "@maskito/kit": "^5.6.0",
    "@maskito/phone": "^5.6.0",
    "@ng-web-apis/common": "^5.4.0",
    "@ng-web-apis/intersection-observer": "^5.4.0",
