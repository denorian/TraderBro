# Build stage — compile the Angular UI to static assets
FROM node:22-alpine AS build
# registry.npmjs.org is blocked from the corporate network (self-signed cert intercept), so npm
# resolves through the internal Artifactory npm mirror — same as Maven does for Java deps.
ARG NPM_REGISTRY=https://artifactory.tcsbank.ru/artifactory/api/npm/npm-all
ENV npm_config_registry=$NPM_REGISTRY
WORKDIR /app
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
# baseHref is overridden to / because this standalone nginx container serves the app at the
# root (the /ui/ prefix in angular.json is only used when Spring Boot serves the bundle).
RUN npm run build -- --base-href=/

# Runtime stage — serve the built app + proxy /api to the backend container
FROM nginx:1.27-alpine
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ui /usr/share/nginx/html
EXPOSE 80