<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console: human-readable, with secret masking. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File: JSON lines for machine consumption. -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR:-logs}/traderbro.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR:-logs}/traderbro.%d{yyyy-MM-dd}.json.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
                <includeException>true</includeException>
            </layout>
        </encoder>
    </appender>

    <!-- Trade audit: dedicated appender for signals/orders/trades/risk decisions. -->
    <appender name="TRADE_AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR:-logs}/trade-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR:-logs}/trade-audit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.traderbro" level="INFO" additivity="false">
        <appender-ref ref="TRADE_AUDIT"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>